# Runtime RmlUI templates used by Eclipse Studio.
!/bin/
/bin/*
!/bin/Data/
/bin/Data/*
!/bin/Data/UI/
/bin/Data/UI/*
!/bin/Data/UI/Assets/
/bin/Data/UI/Assets/*
