<rml>
<head>
<title>WarInc Studio</title>
<link type="text/rcss" href="Data/UI/Assets/css/warinc_common.rcss" />
</head>

<body>
<div id="root">
    <div id="backdrop"></div>
    <div id="noise_a"></div>
    <div id="noise_b"></div>
    <div id="left_strip"></div>
    <div id="right_strip"></div>

    <div id="panel" class="app-panel">
        <div id="title" class="app-title">WARINC STUDIO</div>
        <div id="subtitle" class="app-subtitle">TACTICAL DEVELOPMENT FRONTEND</div>

        <button id="play" class="app-button" onclick="dummy">PLAY GAME</button>
        <button id="level" class="app-button" onclick="dummy">LEVEL EDITOR</button>
        <button id="particle" class="app-button" onclick="dummy">PARTICLE EDITOR</button>
        <button id="physics" class="app-button" onclick="dummy">PHYSICS EDITOR</button>
        <button id="character" class="app-button" onclick="dummy">CHARACTER EDITOR</button>
        <button id="exit" class="app-button app-exit" onclick="dummy">EXIT</button>

        <div id="footer" class="app-footer">DX11 GAME RENDERER / RMLUI EDITOR MENU</div>
    </div>
</div>
</body>
</rml>