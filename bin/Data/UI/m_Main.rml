<rml>
<head>
<title>WarInc Command Center</title>
<link type="text/rcss" href="Data/UI/Assets/css/warinc_common.rcss" />
</head>

<body>
<div id="root" class="wi-root">
    <div class="wi-backdrop"></div>
    <div class="wi-top-strip"></div>
    <div class="wi-bottom-strip"></div>
    <div class="wi-left-strip"></div>
    <div class="wi-right-strip"></div>

    <div id="panel" class="wi-panel wi-panel-main">
        <div id="panel_inner" class="wi-panel-inner wi-panel-main-inner">
            <div class="wi-accent-line wi-main-line"></div>

            <div id="header" class="wi-header wi-main-header">
                <div id="title" class="wi-title wi-main-title">WARINC COMMAND</div>
                <div id="subtitle" class="wi-subtitle wi-main-subtitle">LEVEL CONTROL / TACTICAL EDITOR INTERFACE</div>
                <div id="header_badge" class="wi-badge wi-main-badge">DX11 NATIVE<br />RMLUI FRONTEND</div>
            </div>

            <div id="tabs">
                <button id="tab_live" class="{{tab_live_class}}" onclick="dummy">LIVE MAPS</button>
                <button id="tab_editor" class="{{tab_editor_class}}" onclick="dummy">EDITOR MAPS</button>
                <button id="tab_create" class="{{tab_create_class}}" onclick="dummy">CREATE MAP</button>
            </div>

            <div id="content">{{content}}</div>
            <div id="status" class="wi-status">{{status}}</div>
            <div id="footer" class="wi-footer">WARINC / DX11 / RMLUI</div>
        </div>
    </div>
</div>
</body>
</rml>