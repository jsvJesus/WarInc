<rml>
<head>
	<title>WarInc Command Center</title>
	<link type="text/rcss" href="Data/UI/Assets/css/warinc_common.rcss" />
</head>

<body>
<div id="root">
    <div id="backdrop"></div>
    <div id="noise_a"></div>
    <div id="noise_b"></div>
    <div id="left_strip"></div>
    <div id="right_strip"></div>

    <div id="panel">
        <div id="panel_inner">
            <div id="top_line"></div>

            <div id="header">
                <div id="title">WARINC COMMAND</div>
                <div id="subtitle">LEVEL CONTROL</div>
                <div id="header_badge">FRONTEND</div>
            </div>

            <div id="tabs">
                <button id="tab_live" class="{{tab_live_class}}" onclick="dummy">LIVE MAPS</button>
                <button id="tab_editor" class="{{tab_editor_class}}" onclick="dummy">EDITOR MAPS</button>
                <button id="tab_create" class="{{tab_create_class}}" onclick="dummy">CREATE MAP</button>
            </div>

            <div id="content">{{content}}</div>
            <div id="status">{{status}}</div>
            <div id="footer">RMLUI EDITOR MENU</div>
        </div>
    </div>
</div>
</body>
</rml>