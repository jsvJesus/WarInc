<rml>
<head>
	<title>WarInc Level Editor</title>
	<link type="text/rcss" href="Data/UI/Assets/css/warinc_editor.rcss" />
</head>

<body>
	<div id="level-editor-root">
		<div id="level-editor-bar">
			<div id="level-editor-brand">
				<div id="level-editor-title">LEVEL EDITOR</div>
				<div id="level-editor-subtitle">WarInc Tools</div>
			</div>

			<div id="level-editor-nav">
				<div id="le-settings" class="level-editor-button">Settings</div>
				<div id="le-terrain" class="level-editor-button">Terrain</div>
				<div id="le-objects" class="level-editor-button">Objects</div>
				<div id="le-materials" class="level-editor-button">Materials</div>
				<div id="le-environment" class="level-editor-button">Environment</div>
				<div id="le-collections" class="level-editor-button">Collections</div>
				<div id="le-decorators" class="level-editor-button">Decorators</div>
				<div id="le-roads" class="level-editor-button">Roads</div>
				<div id="le-gameplay" class="level-editor-button">Gameplay</div>
				<div id="le-postfx" class="level-editor-button">Post FX</div>
				<div id="le-colorgrading" class="level-editor-button level-editor-wide">Color Correction</div>
			</div>

			<div id="level-editor-right">
				<div id="level-editor-status">DX11 RML UI</div>
			</div>
		</div>
	</div>
</body>
</rml>