<rml>
<head>
<title>WarInc Loading</title>
<link type="text/rcss" href="Data/UI/Assets/css/warinc_common.rcss" />
</head>

<body>
<div id="root" class="wi-root">
    <div class="wi-backdrop"></div>
    <div class="wi-top-strip"></div>
    <div class="wi-bottom-strip"></div>
    <div class="wi-left-strip"></div>
    <div class="wi-right-strip"></div>

    <div id="loading_panel" class="wi-loading-panel">
        <div class="wi-loading-line"></div>

        <div id="loading_title">LOADING OPERATION</div>
        <div id="loading_status">Preparing tactical environment...</div>
        <div id="loading_percent">0%</div>

        <div id="loading_bar">
            <div id="loading_bar_fill"></div>
        </div>
    </div>
</div>
</body>
</rml>