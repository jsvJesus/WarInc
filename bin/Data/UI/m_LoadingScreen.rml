<rml>
<head>
<title>WarInc Loading</title>
<link type="text/rcss" href="Data/UI/Assets/css/warinc_common.rcss" />
</head>

<body>
<div id="root">
    <div id="backdrop"></div>
    <div id="noise_a"></div>
    <div id="noise_b"></div>
    <div id="left_strip"></div>
    <div id="right_strip"></div>

    <div id="shade"></div>

    <div id="content" class="loading-content">
        <div id="map_name">Loading</div>
        <div id="map_desc"></div>
        <div id="map_mode"></div>

        <div id="tip_box">
            <div id="tip_caption"></div>
            <div id="tip_text"></div>
        </div>

        <div id="progress_text">0%</div>

        <div id="progress_track">
            <div id="progress_bar"></div>
        </div>
    </div>
</div>
</body>
</rml>