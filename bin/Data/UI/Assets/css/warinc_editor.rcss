body
{
	margin: 0px;
	padding: 0px;
	width: 100%;
	height: 100%;
	font-family: Arial;
	color: #d7dde6;
}

#level-editor-root
{
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 52px;
}

#level-editor-bar
{
	position: absolute;
	left: 5px;
	top: 5px;
	width: 1910px;
	height: 42px;
	background-color: #0b0f15;
	border-width: 1px;
	border-color: #27313f;
}

#level-editor-brand
{
	position: absolute;
	left: 12px;
	top: 5px;
	width: 140px;
	height: 32px;
}

#level-editor-title
{
	position: absolute;
	left: 0px;
	top: 0px;
	width: 140px;
	height: 18px;
	color: #f0f3f7;
	font-size: 15px;
	font-weight: bold;
}

#level-editor-subtitle
{
	position: absolute;
	left: 1px;
	top: 18px;
	width: 140px;
	height: 14px;
	color: #8f99a8;
	font-size: 11px;
}

#level-editor-nav
{
	position: absolute;
	left: 160px;
	top: 7px;
	width: 1460px;
	height: 30px;
}

.level-editor-button
{
	float: left;
	width: 94px;
	height: 28px;
	margin-right: 4px;
	padding-top: 0px;
	padding-left: 4px;
	padding-right: 4px;

	background-color: #151b25;
	border-width: 1px;
	border-color: #303a49;

	color: #aeb8c8;
	font-size: 12px;
	line-height: 28px;
	text-align: center;
}

.level-editor-wide
{
	width: 132px;
}

.level-editor-button:hover
{
	background-color: #202938;
	border-color: #59687d;
	color: #ffffff;
}

.level-editor-button:active
{
	background-color: #293447;
	border-color: #8a9ab2;
	color: #ffffff;
}

.level-editor-button.is-active
{
	background-color: #9b4a1b;
	border-color: #ff9a3d;
	color: #ffffff;
}

#level-editor-right
{
	position: absolute;
	right: 14px;
	top: 8px;
	width: 170px;
	height: 26px;
}

#level-editor-status
{
	position: absolute;
	right: 0px;
	top: 0px;
	width: 170px;
	height: 26px;

	color: #7f8ea3;
	font-size: 11px;
	line-height: 26px;
	text-align: right;
}